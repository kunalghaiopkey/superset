# Allowing python to print() in docker
PYTHONUNBUFFERED=1

COMPOSE_PROJECT_NAME=superset
DEV_MODE=true

# database configurations
DATABASE_DB=superset
DATABASE_HOST=host.docker.internal
DATABASE_PASSWORD=root
DATABASE_USER=root
DATABASE_PORT=3306
DATABASE_DIALECT=mysql
DATABASE_URL=mysql+pymysql://root:root@host.docker.internal:3306/superset

EXAMPLES_DB=examples
EXAMPLES_HOST=db
EXAMPLES_USER=examples
EXAMPLES_PASSWORD=examples
EXAMPLES_PORT=5432

# database engine specific environment variables (old postgres vars, can ignore)
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset
#MYSQL_DATABASE=superset
#MYSQL_USER=superset
#MYSQL_PASSWORD=superset
#MYSQL_RANDOM_ROOT_PASSWORD=yes

# python path
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev

# redis
REDIS_HOST=redis 
REDIS_PORT=6379

# superset & flask
FLASK_DEBUG=true
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
CYPRESS_CONFIG=false
SUPERSET_PORT=8088
MAPBOX_API_KEY=''

# flask secret key
SUPERSET_SECRET_KEY=TEST_NON_DEV_SECRET

# node / playwright / puppeteer etc
ENABLE_PLAYWRIGHT=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BUILD_SUPERSET_FRONTEND_IN_DOCKER=true

# logging
SUPERSET_LOG_LEVEL=info
